# Copy to .env.local.
# In production both values are mandatory: the server refuses to boot if AUTH_SECRET
# is shorter than 32 characters or ENCRYPTION_KEY is not a base64-encoded 32-byte key.
# Generate values with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"   # ENCRYPTION_KEY
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"      # AUTH_SECRET
# Leave them blank for local development to use the development-only fallbacks.
ENCRYPTION_KEY=
AUTH_SECRET=

# Optional: connect a managed Postgres instead of the embedded PGlite instance.
# DATABASE_URL=postgres://user:pass@host:5432/tokenburn

# Optional: Upstash Redis REST for rate limiting shared across instances.
# When unset, limits are enforced in memory per process (single-instance only).
# Set both values or neither; the boot check rejects a half-configured pair.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: trust X-Forwarded-For / X-Real-IP for client IPs behind a proxy.
# Leave unset locally; automatically enabled on Vercel. Accepts 0, 1, true or false.
# TRUST_PROXY=false

# Optional: enables the coach's natural-language narrative layer.
# OPENAI_API_KEY=
# OPENAI_COACH_MODEL=gpt-4.1-mini

# Optional: provider credentials for the gateway and the live smoke suite.
# These are operator-level: unlike keys saved in Settings (which are encrypted per
# organization), environment keys are shared by every organization served by this
# process and are only used when no stored credential exists for that provider.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=

# Demo seed credentials
DEMO_EMAIL=demo@tokenburn.dev
DEMO_PASSWORD=tokenburn-demo
